# Copy to .env and fill in. The script loads .env automatically (python-dotenv).

# Service-account / PAT bearer token (required)
DFNS_AUTH_TOKEN=

# Signing credential id, cr-... (required)
DFNS_CRED_ID=

# Inline PEM private key for that credential (required).
# Paste the whole key including the BEGIN/END lines; real newlines are fine:
DFNS_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----'

# API base URL (optional, default https://api.dfns.io)
DFNS_API_URL=https://api.dfns.io
